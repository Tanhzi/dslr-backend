APP_NAME=SweetLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# PostgreSQL (Supabase)
DB_CONNECTION=pgsql
DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=

# Supabase Storage (bucket: event-assets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# JWT (HS256) — tạo bằng php artisan key:generate-style (key ngẫu nhiên 64 ký tự)
JWT_SECRET=

# TTL access token (phút) — mặc định 60; hết hạn sẽ tự gia hạn qua POST /api/refresh
JWT_TTL=60
# Cửa sổ gia hạn token ĐÃ hết hạn (phút) — mặc định 7 ngày
JWT_REFRESH_GRACE=10080
# SameSite cookie httpOnly: lax (mặc định, cùng site/proxy) | none (gọi thẳng cross-site, bắt buộc HTTPS)
JWT_COOKIE_SAMESITE=lax

# CORS — whitelist origin FE, KHÔNG dùng '*' (cookie credentials). Phân cách dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Cache
CACHE_STORE=file

# OpenRouter — chatbot AI (chain model free, phân cách dấu phẩy = fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,poolside/laguna-xs-2.1:free

# Brevo — gửi email (QR code, ảnh gốc)
BREVO_API_KEY=

# Token cho GET /api/cleanup-trigger?token=... (cron dọn file media rác)
CLEANUP_TOKEN=
